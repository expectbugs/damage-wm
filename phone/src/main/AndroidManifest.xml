<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- normal permission satisfying the connectedDevice FGS "anyOf" set on
         Android 14+, so the service can start even before the user grants the
         Bluetooth runtime permissions (review round 1: launch crash-loop) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Build W: "home unreachable" is said only while the phone itself is online — NetState follows
         the validated networks with a network callback, which needs this normal permission
         (tools/check_apk_wiring.py reads the merged manifest for it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Build W, package F (W-decisions G.4, G.5): presence from the phone's own position.
         Precise location (with coarse, as the platform requires them together) and
         background location ("Allow all the time"): location read from the shell
         service, whose foreground types stay connectedDevice|mediaPlayback, is
         background access. Nothing runs until both are granted (the app's
         "location" button asks in two steps). No FOREGROUND_SERVICE_LOCATION:
         the service's types do not change. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Music (MUSIC.md §7): the shell service also plays media — the
         second foreground-service type; no RECORD_AUDIO, ever. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- BLE: the live radio path since 2026-08-31 — the phone owns the pair
         all day (Target=glasses); the capability gate refuses non-CFW firmware. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The pocket-liveness trio (2026-08-31, the APK mission — each one a
         G2CC factory finding, android/ manifest + ConnectionService):
         1) PARTIAL_WAKE_LOCK while a GLASSES stack runs: the FGS type stops
            process-kill but NOT Doze CPU throttling — G2CC measured delay()
            ticks gapping 13-28 s on a 10 s cadence without it, and our FB
            lease renews every 45 s against a 90 s fail-open expiry;
         2) the battery-optimization exemption (user-granted; MainActivity
            asks once): without it Doze can stop even a foreground service;
         3) boot/update auto-start so the default path — the phone driving
            the glasses — survives a reboot and a sideload update. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+): SpotifyRemote's cold start looks up
         Spotify's media-browser service and binds it. Without this declaration
         both lookups are filtered and Spotify reads as "not installed" even
         when it is — the passive session path never showed it because the
         notification-listener grant exempts active sessions only
         (ultrareview 2026-09-02). -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Cleartext HTTP to the PC's media endpoint (:7404) over the tailnet
         (MUSIC.md §6.3): ExoPlayer and the prefetch store use HttpURLConnection,
         which the platform's cleartext policy would otherwise refuse (review
         2026-09-02). The endpoint is token-gated; the transport is Tailscale. -->
    <!-- android:name (APK 0.64): DamageApp installs the uncaught-error record before any
         component runs. Without the attribute the APK still assembles and the class is
         unused: tools/check_apk_wiring.py reads the merged manifest for it. -->
    <application
        android:name=".DamageApp"
        android:usesCleartextTraffic="true"
        android:label="Damage"
        android:icon="@drawable/ic_damage"
        android:theme="@style/Theme.Damage"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShellService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />

        <!-- Music (MUSIC.md §7): the notification listener. It is what
             authorizes MediaSessionManager.getActiveSessions() for Spotify's
             session (verdict 3/20/25) and what sees the phone's
             hearing-safety "volume lowered" notice (verdict 14). The user
             grants notification access once, in Settings; nothing here binds
             the service itself — the system does.
             exported="false" + the BIND permission is the shape G2CC's own
             listener has run in daily on this phone: the system server binds
             it as uid SYSTEM, which is allowed past the export check. -->
        <service
            android:name=".music.MusicListener"
            android:exported="false"
            android:label="Damage music"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Boot/update auto-start (the G2CC BootReceiver pattern): the phone
             is the default driver of the glasses, so a reboot or a sideload
             update must not leave the pair undriven until the app is opened.
             Gated inside the receiver on Target=GLASSES and the battery-opt
             exemption; connectedDevice-type FGS is allowed from
             BOOT_COMPLETED. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
